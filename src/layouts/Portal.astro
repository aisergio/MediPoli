---
import "../styles/portal.css";
const { title = "MediPoli | Agenda de citas", bodyClass } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Portal académico MediPoli para la gestión de citas de medicina general y odontología en Bogotá." />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="topbar">
      <div class="frame topbar-inner">
        <a href={base} class="brand" aria-label="MediPoli inicio"><span class="brand-icon" aria-hidden="true">+</span><span>MediPoli<small>IPS · Bogotá</small></span></a>
        <nav aria-label="Principal">
          <a href={base + "#servicios"}>Servicios</a>
          <a href={base + "#sedes"}>Sedes</a>
          <a class="nav-action" href={base + "agenda/"}>Mi agenda <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>
    <main id="contenido"><slot /></main>
    <footer class="site-footer">
      <div class="frame footer-inner">
        <div><span class="footer-brand">MediPoli</span><p>Medicina general y odontología · Bogotá</p></div>
        <p>Proyecto académico ficticio. Usa únicamente cuentas y datos de demostración.</p>
      </div>
    </footer>
  </body>
</html>
